{
  "manifest_version": 3,
  "name": "PDF Wizard CAC Signing",
  "version": "1.0.0",
  "description": "Lets the PDF Wizard PDF app sign documents with your CAC (Common Access Card) through the PDF Wizard CAC helper.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "110"
}
